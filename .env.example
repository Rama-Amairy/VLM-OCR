LOG_DIR=logs

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=glm-ocr
OLLAMA_TIMEOUT=1200
OLLAMA_TEMPERATURE=0
OCR_PROMPT=Text Recognition:
# optional: leave commented to use the Ollama default (baseline)
# OLLAMA_NUM_CTX=16384
# keeps the model loaded in GPU memory between requests
OLLAMA_KEEP_ALIVE=30m

MAX_FILE_SIZE_MB=20
MAX_PAGES=12
PDF_DPI=100
MAX_IMAGE_SIDE=800
OUTPUT_DIR=outputs
